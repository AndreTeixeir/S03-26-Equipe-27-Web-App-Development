# Variáveis do Docker Compose (infra/docker-compose.yml).
# Copie este arquivo para infra/.env e preencha os valores. O .env não é versionado.
#
# As senhas NÃO têm valor padrão: sem elas o "docker compose" se recusa a subir.
# Gere valores fortes e únicos, por exemplo com: openssl rand -base64 24

# Arquivos de variáveis lidos pelos containers do backend e do frontend.
SMARTTRAFFIC_BACKEND_ENV_FILE=/opt/smarttrafficflow/env/backend.env
SMARTTRAFFIC_FRONTEND_ENV_FILE=/opt/smarttrafficflow/env/frontend.env

# Diretório do host com o export.geojson de ruas (montado como somente leitura no backend).
SMARTTRAFFIC_DATA_DIR=/opt/smarttrafficflow/data

# Banco de dados (PostgreSQL + PostGIS).
SMARTTRAFFIC_DB_USER=postgres
# OBRIGATÓRIA. Deve ser a mesma senha usada em SPRING_DATASOURCE_PASSWORD no backend.env.
SMARTTRAFFIC_DB_PASSWORD=
SMARTTRAFFIC_DB_NAME=smarttrafficflow
# Endereço e porta do host em que o banco é publicado (somente local por padrão).
SMARTTRAFFIC_DB_PORT_BIND=127.0.0.1:5432

# pgAdmin (perfil "admin"). A senha é exigida mesmo sem o perfil, porque o Compose lê o arquivo inteiro.
SMARTTRAFFIC_PGADMIN_EMAIL=admin@admin.com
# OBRIGATÓRIA.
SMARTTRAFFIC_PGADMIN_PASSWORD=
SMARTTRAFFIC_PGADMIN_PORT_BIND=127.0.0.1:8100
