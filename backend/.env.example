# Variáveis do backend. Copie este arquivo para backend/.env (ou para o arquivo apontado por
# SMARTTRAFFIC_BACKEND_ENV_FILE no Docker Compose) e preencha os valores. O .env não é versionado.
#
# O Spring Boot NÃO lê o arquivo .env sozinho. Ao rodar fora do Docker, exporte as variáveis no
# terminal ou cadastre-as na configuração de execução da IDE (por exemplo, no IntelliJ).

SPRING_PROFILES_ACTIVE=default
SERVER_PORT=8080

# Conexão com o banco. No Docker Compose o host do banco é o nome do serviço (smarttraffic-db).
SPRING_DATASOURCE_URL=jdbc:postgresql://smarttraffic-db:5432/smarttrafficflow
SPRING_DATASOURCE_USERNAME=postgres
# OBRIGATÓRIA, sem valor padrão: sem ela a aplicação se recusa a subir.
# Deve ser a mesma senha de SMARTTRAFFIC_DB_PASSWORD no infra/.env.
SPRING_DATASOURCE_PASSWORD=

# Origens autorizadas a chamar a API pelo navegador, separadas por vírgula.
# No Docker Compose esta variável é definida pelo próprio compose (https://<SMARTTRAFFIC_DOMAIN>)
# e sobrescreve o valor deste arquivo. Use-a ao rodar o backend fora do Docker.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5174

# Importação das ruas a partir do GeoJSON (ver infra/README.md).
APP_STREETS_IMPORT_ENABLED=true
APP_STREETS_IMPORT_GEOJSON_PATH=/runtime-data/export.geojson
